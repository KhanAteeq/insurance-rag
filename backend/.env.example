# ============================================================================
# Insurance RAG — Backend environment configuration (EXAMPLE)
# ----------------------------------------------------------------------------
# Copy this file to ".env" and adjust values as needed. All settings are
# optional — the defaults in app/config.py are sensible for local dev.
# ============================================================================

# --- Application ------------------------------------------------------------
APP_NAME=Insurance RAG API
APP_VERSION=1.0.0
DEBUG=false

# --- HTTP server ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Embeddings -------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- Vector store (ChromaDB) ------------------------------------------------
COLLECTION_NAME=insurance_claims
TOP_K=5

# --- Ollama (local LLM) -----------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192

# --- Safety / limits --------------------------------------------------------
MAX_QUESTION_LENGTH=2000
MAX_UPLOAD_BYTES=26214400

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# ============================================================================
# AZURE MODE (set BACKEND_MODE=azure to use Azure OpenAI instead of Ollama).
# Leave BACKEND_MODE=local for the offline setup. Fill these when deploying.
# ============================================================================
BACKEND_MODE=local
AZURE_OPENAI_ENDPOINT=https://openai-insurance-rag.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_DIMENSION=1536
AZURE_MAX_COMPLETION_TOKENS=1024

